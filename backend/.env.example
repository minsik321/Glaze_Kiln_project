SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# LLM 프런트도어 (docs/AICE_LLM_FRONTDOOR_PLAN.md §8)
# 텍스트(RAG 레시피 추천)·이미지(레시피 예상 이미지) 생성을 aimlapi.com
# 단일 게이트웨이로 통합 사용한다. backend/.env에만 두고 프런트엔드로
# 절대 전달하지 않는다(브라우저로 보내는 응답에는 결과만 담는다).
AIMLAPI_API_KEY=
AIMLAPI_BASE_URL=https://api.aimlapi.com/v1
# 텍스트 모델명은 실제 사용 가능한 모델 ID를 발급받은 aimlapi 계정
# 대시보드와 https://docs.aimlapi.com/api-references/model-database 에서
# 확인 후 채운다(모델 목록·명명 규칙이 자주 바뀐다).
#
# 2026-09-18 실측 비교(backend/scripts/_manual_review/chat_bakeoff_result.json,
# GPT/Gemini 각 3종을 실제 build_target_messages/build_messages로 호출):
# 배합비는 LLM이 정하지 않고(kiln.search가 정함) 이름·착색·소성 메모만
# 붙이는 정도라 원래 쓰던 anthropic/claude-sonnet-4.6(2차 호출 실측
# ~27초) 크기 모델이 필요 없었다. google/gemini-3.5-flash-lite가
# 스키마 검증(5개 전부 통과)·서술 다양성(후보마다 다른 근거 문장)·속도
# (2차 ~4초) 모두 gpt-4o-mini/gpt-4.1-mini와 동급 이상이면서 제일
# 빠르다. gpt-5-nano는 "nano"인데도 숨은 reasoning 토큰 때문에 42초·
# 6480토큰으로 가장 느리고 비쌌다 — 이름만 보고 고르면 안 된다.
# google/gemini-2.5-flash-lite는 5개 후보 서술이 전부 같은 문장을
# 반복해(차별화 실패) 2차용으로는 탈락시켰다(1차용으로는 문제 없음,
# 아래 AIMLAPI_TARGET_MODEL 참고).
AIMLAPI_TEXT_MODEL=google/gemini-3.5-flash-lite
# 1차 호출(목표 분류 — (광택도, 투명도) 두 필드만 반환)에만 쓰는 가벼운
# 모델. 비워두면 AIMLAPI_TEXT_MODEL을 그대로 쓴다. 이 작업은 후보별
# 차별화가 필요 없어(출력이 하나뿐) 2차에서 탈락시킨
# gemini-2.5-flash-lite의 반복 문제가 적용되지 않고, 실측 6종 중
# 가장 빨랐다(0.94초).
AIMLAPI_TARGET_MODEL=google/gemini-2.5-flash-lite
# 이미지 모델 = google/nano-banana (Google의 텍스트/이미지-프롬프트 겸용
# 네이티브 이미지 생성 모델). 화면 1에서 "자연어 스타일 설명 + (선택) 색상
# 사진"을 함께 받아 예상 레시피 이미지를 만들어야 하는데, 이 모델은 이미지를
# 프롬프트로 함께 넣는 image-conditioned 생성을 지원해서 색상 참고 사진을
# 실제로 반영할 수 있다(Flux 계열 상당수는 텍스트 전용). 가격은 장당 약
# $0.05~0.065 수준 — 화면 1에서 후보 5장을 만들면 세션당 약 $0.3 내외로
# 데모 단계에서는 부담이 크지 않다.
#
# 2026-09-18에 더 저렴한 대안 3종을 실측 비교했다(이미지·프롬프트·레시피
# 문구는 backend/scripts/_manual_review/aimlapi_images/manifest.json):
# flux/schnell(약 $0.004/장)은 "은은한 사틴 청록 유약" 프롬프트에서
# 도자기가 아니라 흰색 광물 원석 사진을 냈고(도메인 이해 실패),
# openai/gpt-image-1-mini는 색·질감이 실제 유약과 거리가 멀고 속도(14초)·
# 용량(1.7MB)도 nano-banana(13.5초·1.3MB)보다 나빴다.
# google/imagen-4.0-fast-generate-001은 카탈로그엔 있지만 이 aimlapi
# 계정에서 404(리전/권한 미접근) — 카탈로그 등재가 곧 실제 접근 가능을
# 뜻하지 않는다. 세 대안 다 기각하고 nano-banana를 유지한다.
AIMLAPI_IMAGE_MODEL=google/nano-banana

# 일시적 장애 대응 — aimlapi.com은 제3자 게이트웨이라 대체 경로가 없다
# (docs/AICE_LLM_FRONTDOOR_PLAN.md §9). 429/502/503/504만 지수 백오프로
# 재시도한다(인증·검증 오류는 재시도하지 않음).
AIMLAPI_MAX_RETRIES=2
AIMLAPI_RETRY_BACKOFF_SECONDS=1.0

# 응답 생성(read) 대기 상한 — 후보 서술처럼 생성이 오래 걸리는 호출이
# 여기서 자주 잘렸다면 늘린다(최대 120). 연결 자체가 안 되는 진짜 장애는
# 아래 CONNECT_TIMEOUT이 따로 짧게 잡아 재시도가 늦어지지 않게 한다.
AIMLAPI_TIMEOUT_SECONDS=90
AIMLAPI_CONNECT_TIMEOUT_SECONDS=10

# RAG(수정 사항 정리 3번) — Docker로 띄운 Qdrant 벡터 DB(vectorstore.py).
# 루트 docker-compose.yml로 `docker compose up -d` 하면 기본 포트가
# 이 URL과 맞는다. 비워두면 RAG는 조용히 꺼지고(레시피 추천은 그대로
# 동작) 콜드스타트로 대체된다 — Supabase처럼 "설정 안 되면 기능만 꺼짐"
# 원칙(aimlapi_configured/qdrant_configured 프로퍼티 참고).
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=aice_knowledge
