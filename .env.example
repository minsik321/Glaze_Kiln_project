VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_API_URL=http://127.0.0.1:8000

# LLM 프런트도어(RAG 레시피 추천·이미지 생성) API 키는 여기(루트 .env)가
# 아니라 backend/.env(backend/.env.example 참고)에 둔다. 루트 .env는 Vite가
# 읽어 프런트엔드 빌드에 들어가므로, 여기 두면 VITE_ 접두사가 없어도
# 실수로 노출시키기 쉽다. 서버 사이드 전용 키는 backend/ 쪽에서만 관리한다
# (docs/AICE_LLM_FRONTDOOR_PLAN.md §8).
