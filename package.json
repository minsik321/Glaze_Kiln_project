{
  "name": "glaze-kiln",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:backend": ".venv\\Scripts\\python.exe -m uvicorn backend.app.main:app --reload --port 8000",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:database && npm run test:react",
    "test:backend": ".venv\\Scripts\\python.exe -m pytest backend/tests -q",
    "test:python": ".venv\\Scripts\\python.exe -m pytest tests -q",
    "test:all": "npm test && npm run test:backend && npm run test:python && npm run test:e2e && npm run build",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > app/react/lib/database.types.ts",
    "test:database": "node --test scripts/*.test.mjs",
    "test:react": "vitest run",
    "db:check": "node scripts/check-supabase.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "supabase": "^2.39.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.0"
  }
}
